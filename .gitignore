.DS_Store
__pycache__/
*.pyc
*.log

# real config and anything personal: only the *.example.* templates are committed
config/*.md
!config/*.example.md
config/*.json
!config/*.example.json
.claude/settings.json
.claude/settings.local.json

# runtime records: briefs, outbox drafts and the log hold real mail; keep them in a private repo
/briefs/
/log/
/outbox/*
!/outbox/README.md

# dashboard collector output (prompt previews, titles) and its local config
dashboard/data/*
!dashboard/data/.gitkeep
dashboard/dist/
dashboard/config.json

# secrets
.env
.env.*
*secrets*/
tokens.json
*cookies*.json
*.pem
*.key
*.p12
