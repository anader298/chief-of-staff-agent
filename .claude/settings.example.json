{
  "_comment": "Copy to .claude/settings.json. Hooks are what make the rules hold: the model cannot talk its way past an exit code. Only the owner creates outbox/APPROVED, by hand in his own terminal; the deny rules and block_send.sh refuse the agent.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent",
      "Bash(python3 tools/mail.py inbox:*)",
      "Bash(python3 tools/mail.py draft:*)",
      "Bash(python3 tools/mail.py list-drafts:*)",
      "Bash(python3 tools/preflight.py:*)",
      "Bash(git:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/cos/**)",
      "Write(./outbox/APPROVED)",
      "Edit(./outbox/APPROVED)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/block_send.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/sync_repos.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/sync_repos.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dashboard/refresh.sh"
          }
        ]
      }
    ]
  }
}
